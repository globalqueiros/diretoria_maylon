# ============================================================
# Portal Connect - Maylon
# Copie este arquivo para .env.local e preencha os valores reais.
# NUNCA commite segredos no .env.local.
# ============================================================

# ---------- Banco de dados principal (maylon_db) ----------
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---------- Banco de dados secundário (smartmobility_db) ----------
DB2_HOST=
DB2_USER=
DB2_PASSWORD=
DB2_NAME=

# ---------- Google Maps ----------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------- JWT / Autenticação ----------
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------- AWS S3 (foto-temporarias) ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=foto-temporarias

# ---------- AWS S3 (documentos-fiscais-prod) ----------
AWS_REGION_1=us-east-1
AWS_ACCESS_KEY_ID_1=
AWS_SECRET_ACCESS_KEY_1=
AWS_S3_BUCKET_1=documentos-fiscais-prod

# ---------- AWS S3 (curriculo-prod) ----------
AWS_REGION_2=us-east-1
AWS_ACCESS_KEY_ID_2=
AWS_SECRET_ACCESS_KEY_2=
AWS_S3_BUCKET_2=curriculo-prod

# ---------- AWS S3 (maylon-store) ----------
AWS_REGION_3=us-east-1
AWS_ACCESS_KEY_ID_3=
AWS_SECRET_ACCESS_KEY_3=
AWS_S3_BUCKET_3=maylon-store

# ---------- Huggy.io (API v3) ----------
HUGGY_BASE_URL=https://api.huggy.app/v3
HUGGY_AUTH_URL=https://auth.huggy.app/oauth/access_token
HUGGY_CLIENT_ID=
HUGGY_CLIENT_SECRET=
HUGGY_REFRESH_TOKEN=
HUGGY_COMPANY_ID=

# ---------- SMTP / E-mail ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM="Portal Connect - Maylon <no-reply@maylon.com.br>"

EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Portal Connect - Maylon <no-reply@maylon.com.br>"

# ---------- URLs públicas ----------
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
NEXT_PUBLIC_STRIPE_KEY=

# ---------- BTG ----------
BTG_CLIENT_ID=
BTG_CLIENT_SECRET=
BTG_SECRET=
